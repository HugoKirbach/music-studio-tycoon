{
  "name": "music-studio-tycoon",
  "productName": "Music Studio Tycoon",
  "version": "1.0.0",
  "description": "Jeu de gestion en 3D : monte ton studio de musique, de ta chambre au complexe légendaire.",
  "author": "Hugo",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "android:prepare": "cap add android && capacitor-assets generate --android && cap sync android",
    "android:apk": "cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fr.premiermix.game",
    "productName": "Music Studio Tycoon",
    "copyright": "Music Studio Tycoon",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["electron/**", "www/**", "package.json"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Music Studio Tycoon",
      "artifactName": "MusicStudioTycoon-Installation-${version}.exe"
    },
    "portable": { "artifactName": "MusicStudioTycoon-Portable-${version}.exe" }
  }
}
